{% assign chosen_max = trmnl.plugin_settings.custom_fields_values.max_games | default: 'auto' %}
{% assign layout = trmnl.plugin_settings.custom_fields_values.layout | default: 'auto' %}
{% assign capacity = 6 %}{% if layout == 'wide' %}{% assign capacity = 6 %}{% endif %}{% if chosen_max != 'auto' %}{% assign capacity = chosen_max | plus: 0 %}{% endif %}
<div class="khl"><header><img class="league-logo" src="data:image/png;base64," alt="КХЛ"><h1 class="title">{% if status == 'ok' %}{% if is_today %}{{ today }}{% else %}{{ upcoming }} {{ game_date }}{% endif %}{% elsif status == 'empty' %}{{ seasonOver }}{% else %}{{ unavailable }}{% endif %}</h1></header>{% if status == 'ok' %}<main class="games">{% for game in games limit: capacity %}<article class="game"><time class="value">{{ game.time }}</time><div><span class="label">{{ game.home }}</span><span class="label">{{ game.away }}</span></div></article>{% endfor %}</main>{% if games.size > capacity %}<footer>+{{ games.size | minus: capacity }} {{ more }}</footer>{% endif %}{% else %}<main class="state"><strong>{% if status == 'empty' %}{{ seasonOver }}{% else %}{{ unavailable }}{% endif %}</strong><span>{% if status == 'empty' %}~ {{ season_days }} {{ seasonCountdown }}{% else %}{{ unavailableDetail }}{% endif %}</span></main>{% endif %}</div>
<style>.khl{height:100%;box-sizing:border-box;padding:15px 17px;font-family:"Noto Sans",Arial,sans-serif;}.khl header{display:flex;align-items:center;gap:8px;border-bottom:3px solid;padding-bottom:7px}.league-logo{width:24px;height:26px;object-fit:contain}h1{margin:0;font-size:1.0625rem;line-height:1.05;letter-spacing:-.3px}.games{columns:2;column-gap:12px;padding-top:10px}.game{display:grid;grid-template-columns:40px minmax(0,1fr);gap:4px;min-width:0;margin-bottom:9px;break-inside:avoid;font-size:.8125rem;line-height:1.1}.game time{font:700 .8125rem ui-monospace,monospace;letter-spacing:-1px}.game div{display:grid;gap:1px;min-width:0}.game span{display:block;width:100%;box-sizing:border-box;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}footer{margin-top:7px;font-size:.75rem;font-weight:700}.state{display:grid;gap:5px;padding-top:18px;font-size:.9375rem}.state span{font-size:.75rem}@media(max-width:330px){.games{columns:1}.khl{padding:12px}h1{font-size:.9375rem}}</style>

