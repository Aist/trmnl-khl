{% assign chosen_max = trmnl.plugin_settings.custom_fields_values.max_games | default: 'auto' %}
{% assign show_date = trmnl.plugin_settings.custom_fields_values.show_date | default: true %}
{% assign layout = trmnl.plugin_settings.custom_fields_values.layout | default: 'auto' %}
{% assign capacity = 8 %}
{% if layout == 'compact' %}{% assign capacity = 6 %}{% elsif layout == 'standard' %}{% assign capacity = 6 %}{% endif %}
{% if chosen_max != 'auto' %}{% assign capacity = chosen_max | plus: 0 %}{% endif %}
<div class="khl khl-full">
  <header><img class="league-logo" src="data:image/png;base64," alt="КХЛ"><div><h1 class="title">{% if status == 'ok' %}{% if is_today %}{{ today }}{% else %}{{ upcoming }} {{ game_date }}{% endif %}{% elsif status == 'empty' %}{{ noGames }}{% else %}{{ unavailable }}{% endif %}</h1>{% if status == 'ok' and is_today == false and show_date != 'false' %}<p>{{ game_date }}</p>{% endif %}</div></header>
  {% if status == 'ok' %}<main class="games">{% for game in games limit: capacity %}<article class="game"><time class="value">{{ game.time }}</time><div><span class="label">{% if game.home_logo != blank %}<img class="team-logo" src="{{ game.home_logo }}" alt="">{% endif %}{{ game.home }}</span><span class="label">{% if game.away_logo != blank %}<img class="team-logo" src="{{ game.away_logo }}" alt="">{% endif %}{{ game.away }}</span></div></article>{% endfor %}</main>{% if games.size > capacity %}<footer>+{{ games.size | minus: capacity }} {{ more }}</footer>{% endif %}{% else %}<main class="state"><strong>{% if status == 'empty' %}{{ noGames }}{% else %}{{ unavailable }}{% endif %}</strong><span>{% if status == 'empty' %}{{ noGamesDetail }}{% else %}{{ unavailableDetail }}{% endif %}</span></main>{% endif %}
</div>
<style>
.khl{height:100%;box-sizing:border-box;padding:30px 34px;background:#fff;font-family:"Noto Sans",Arial,sans-serif}.khl header{display:flex;align-items:center;gap:14px;border-bottom:4px solid #000;padding-bottom:13px}.league-logo{width:39px;height:40px;object-fit:contain;filter:grayscale(1) contrast(2)}.khl h1{margin:0;font-size:1.6875rem;line-height:1.05;letter-spacing:-.7px}.khl p{margin:3px 0 0;font-size:.9375rem}.games{columns:3;column-gap:30px;padding-top:18px}.game{display:grid;grid-template-columns:52px minmax(0,1fr);gap:8px;min-width:0;margin-bottom:13px;break-inside:avoid;font-size:1.1875rem;line-height:1.15}.game time{font:700 1.125rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:-1px}.game div{min-width:0;display:grid;gap:3px}.game span{display:block;width:100%;box-sizing:border-box;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.team-logo{width:18px;height:18px;object-fit:contain;vertical-align:middle;margin-right:4px;filter:grayscale(1) contrast(1.35)}.khl footer{margin-top:15px;font-weight:700;font-size:.9375rem}.state{display:grid;gap:8px;padding-top:54px;font-size:1.25rem}.state span{font-size:.9375rem}@media(max-width:620px){.khl{padding:22px}.games{columns:2;column-gap:22px}.khl h1{font-size:1.4375rem}.game{font-size:1.0625rem}}@media(max-width:410px){.khl{padding:16px}.games{columns:1}.khl h1{font-size:1.25rem}}
</style>

